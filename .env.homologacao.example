# Homologação. Copie para o painel do Render e da Vercel. Não commite valores reais.
# Não use o banco local meudireito da porta 5434. Ele tem dados de desenvolvimento.

AMBIENTE=homologacao
NOME_COMERCIAL=Tavares Web
CONTROLADOR_PRIVACIDADE=
CONTATO_PRIVACIDADE=
ACESSO_HOMOLOGACAO=
CONFIRMAR_MIGRACAO_HOMOLOGACAO=
GEMINI_API_KEY=
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/meudireito_homologacao
# Gmail: smtp.gmail.com
# Outlook.com: smtp-mail.outlook.com
# Microsoft 365: smtp.office365.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=
SMTP_TLS=1
URL_PUBLICA=
RETENCAO_REGISTRO_EXCLUSAO_DIAS=0
COOKIE_SECURE=1
COOKIE_SAMESITE=none
ORIGENS_PERMITIDAS=
PROXY_CONFIAVEL=1
PROXY_HOSTS=*
